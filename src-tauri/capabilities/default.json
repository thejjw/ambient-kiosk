{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the coordinator webviews only",
  "webviews": ["main", "hud-overlay"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:default",
    "core:webview:allow-set-webview-size",
    "core:webview:allow-set-webview-position",
    "core:window:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-ignore-cursor-events",
    "allow-get-config",
    "allow-save-config",
    "allow-export-config",
    "allow-set-settings-open",
    "allow-start-tour",
    "allow-pause-tour",
    "allow-resume-tour",
    "allow-next-tile",
    "allow-prev-tile",
    "allow-toggle-fullscreen",
    "allow-minimize-current",
    "allow-get-tour-status",
    "allow-get-diagnostics",
    "allow-report-frontend-error"
  ]
}
