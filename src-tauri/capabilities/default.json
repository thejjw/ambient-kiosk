{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main coordinator webview only",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:default",
    "core:webview:allow-set-webview-size",
    "core:webview:allow-set-webview-position",
    "core:window:default",
    "core:window:allow-set-fullscreen",
    "allow-get-config",
    "allow-save-config",
    "allow-export-config"
  ]
}
